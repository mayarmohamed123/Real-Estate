{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Real Estate Platform",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && rimraf dist && npx tsc",
    "start": "node dist/index.js",
    "dev": "prisma generate && concurrently \"npx tsc -w\" \"nodemon --watch dist --exec node dist/index.js\"",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "postprisma:generate": "(shx mkdir -p ../client/types/prisma && shx cp node_modules/.prisma/client/index.d.ts ../client/types/prisma/index.d.ts) || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1085.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@terraformer/wkt": "^2.2.2",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/uuid": "^10.0.0",
    "aws-jwt-verify": "^5.2.1",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "typescript": "^7.0.2",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1"
  }
}
